{
  "name": "ai-agent-job-applications",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "description": "Portable autonomous job applications with existing email connections, browser choice and resumable onboarding.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --outDir .local/build",
    "test": "tsc --outDir .local/check && node --test --test-concurrency=4 .local/check/automation/tests/application-state.test.js .local/check/automation/tests/agentmail.test.js .local/check/automation/tests/agentmail-setup.test.js .local/check/automation/tests/agentmail-connection.test.js .local/check/automation/tests/onboarding.test.js automation/tests/browser.test.mjs .local/check/automation/tests/browser-policy.test.js .local/check/automation/tests/documents.test.js .local/check/automation/tests/email-intake.test.js .local/check/automation/tests/email-discovery.test.js .local/check/automation/tests/multi-vacancy.test.js .local/check/automation/tests/protected-alert.test.js .local/check/automation/tests/captcha.test.js automation/tests/captcha-browser.test.mjs .local/check/automation/tests/onboarding-conversation.test.js",
    "inbox:check": "npm run build --silent && node .local/build/automation/email/agentmail/setup.js",
    "inbox:setup": "npm run build --silent && node .local/build/automation/email/agentmail/setup.js --setup",
    "inbox:detect": "npm run build --silent && node .local/build/automation/email/agentmail/connection.js",
    "inbox:list": "npm run build --silent && node .local/build/automation/email/agentmail/setup.js --list-inboxes",
    "browser": "node automation/browser/cli.mjs",
    "browser:setup": "node automation/browser/setup.mjs --install",
    "browser:check": "node automation/browser/setup.mjs",
    "onboarding:status": "npm run build --silent && node .local/build/automation/onboarding/cli.js status",
    "onboarding:start": "npm run build --silent && node .local/build/automation/onboarding/cli.js start",
    "onboarding:migrate": "npm run build --silent && node .local/build/automation/onboarding/cli.js migrate",
    "onboarding:record": "npm run build --silent && node .local/build/automation/onboarding/cli.js record",
    "onboarding:check": "npm run build --silent && node .local/build/automation/onboarding/cli.js check",
    "onboarding:finish": "npm run build --silent && node .local/build/automation/onboarding/cli.js finish",
    "onboarding:help": "npm run build --silent && node .local/build/automation/onboarding/cli.js help",
    "onboarding:defer": "npm run build --silent && node .local/build/automation/onboarding/cli.js defer-board",
    "onboarding:resume": "npm run build --silent && node .local/build/automation/onboarding/conversation-cli.js resume",
    "onboarding:browser": "npm run build --silent && node .local/build/automation/onboarding/cli.js browser-choice",
    "onboarding:resolve-browser": "npm run build --silent && node .local/build/automation/onboarding/cli.js browser-resolve",
    "onboarding:operation": "npm run build --silent && node .local/build/automation/onboarding/cli.js operation-choice",
    "browser:rehearsal": "node automation/browser/rehearsal.mjs",
    "email:status": "npm run build --silent && node .local/build/automation/email/cli.js status",
    "email:discover": "npm run build --silent && node .local/build/automation/email/cli.js discover",
    "email:options": "npm run build --silent && node .local/build/automation/email/cli.js options",
    "email:catalog": "npm run build --silent && node .local/build/automation/email/cli.js catalog",
    "email:onboarding": "npm run build --silent && node .local/build/automation/email/cli.js onboarding",
    "email:select": "npm run build --silent && node .local/build/automation/email/cli.js select",
    "email:cleanup": "npm run build --silent && node .local/build/automation/email/cli.js cleanup-choice",
    "email:capabilities": "npm run build --silent && node .local/build/automation/email/cli.js capabilities",
    "email:classify": "npm run build --silent && node .local/build/automation/email/cli.js classify",
    "email:migrate": "npm run build --silent && node .local/build/automation/email/cli.js migrate",
    "email:work": "npm run build --silent && node .local/build/automation/email/work-cli.js",
    "email:help": "npm run build --silent && node .local/build/automation/email/cli.js help",
    "onboarding:conversation": "npm run build --silent && node .local/build/automation/onboarding/conversation-cli.js",
    "onboarding:resume-board": "npm run build --silent && node .local/build/automation/onboarding/cli.js resume-board",
    "onboarding:settings": "npm run build --silent && node .local/build/automation/onboarding/conversation-cli.js settings"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/node": "22.20.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "parse5": "8.0.1"
  }
}
